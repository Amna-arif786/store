<% if product.inventory_count.positive? %>
  <div class="inline-flex items-center gap-2 bg-green-50 border border-green-200 text-green-700 px-3 py-1 rounded-full text-sm font-medium mb-4">
    <span class="w-2 h-2 rounded-full bg-green-500"></span>
    <span><%= product.inventory_count %> in stock</span>
  </div>
<% else %>
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 space-y-3 mb-6">
    <div class="flex items-center gap-2 text-red-600 text-sm font-semibold">
      <span class="w-2 h-2 rounded-full bg-red-500"></span>
      <span>Out of stock</span>
    </div>

    <p class="text-sm text-gray-600">Email me when available.</p>

    <%= form_with model: [product, Subscriber.new], class: "flex flex-col sm:flex-row gap-2" do |form| %>
      <%= form.email_field :email, placeholder: "you@example.com", required: true, class: "flex-1 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none" %>
      <%= form.submit "Submit", class: "bg-indigo-600 text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-indigo-700 transition cursor-pointer shadow-sm" %>
    <% end %>
  </div>
<% end %>