<%= form_with model: product, data: { turbo: false }, class: "space-y-6" do |form| %>
  <% if form.object.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">
      <p class="font-semibold"><%= form.object.errors.full_messages.first %></p>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.text_field :name, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none" %>
  </div>

  <div>
    <%= form.label :price, class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.number_field :price, step: "0.01", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none" %>
  </div>
  
  <div>
    <%= form.label :description, style: "display: block", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.rich_textarea :description, class: "w-full rounded-lg border border-gray-300 p-3 text-gray-900 shadow-sm focus:outline-none min-h-[120px]" %>
  </div>

  <div>
    <%= form.label :featured_image, style: "display: block", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.file_field :featured_image, accept: "image/*", class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer" %>
  </div>

  <div>
    <%= form.label :inventory_count, style: "display: block", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.number_field :inventory_count, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none" %>
  </div>

  <div>
    <%= form.submit class: "w-full bg-indigo-600 text-white font-medium py-2.5 px-4 rounded-lg hover:bg-indigo-700 transition cursor-pointer shadow-sm" %>
  </div>
<% end %>