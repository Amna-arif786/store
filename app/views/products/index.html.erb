<div class="max-w-xl mx-auto p-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Products</h1>

    <div>
      <%= link_to "New product", new_product_path, class: "bg-indigo-600 text-white px-4 py-2 rounded font-medium hover:bg-indigo-700 inline-block" if authenticated? %>
      <%= link_to "Login", new_session_path, class: "bg-gray-200 text-gray-800 px-4 py-2 rounded font-medium hover:bg-gray-300 inline-block" unless authenticated? %>
    </div>
  </div>

  <div id="products" class="space-y-4">
    <% @products.each do |product| %>
      <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm">
        <%= link_to product.name, product_path(product.id), class: "text-lg font-semibold text-indigo-600 hover:underline" %>
        <p class="text-gray-600 text-sm mt-1">Price: <%= product.price %></p>
      </div>
    <% end %>
  </div>
</div>