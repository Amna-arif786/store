<div class="max-w-4xl mx-auto px-4 py-8">

<p class="mb-6">
  <%= link_to products_path, class: "inline-flex items-center gap-2 text-indigo-600 hover:underline font-medium" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
    <span>Back to products</span>
  <% end %>
</p>
  <div class="bg-white rounded-xl shadow-md border border-gray-100 p-6 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">

  <div class="w-full flex justify-center">
      <% if @product.featured_image.attached? %>
        <%= image_tag @product.featured_image, class: "rounded-lg max-h-96 object-cover shadow-sm w-full" %>
      <% else %>
        <div class="bg-gray-100 rounded-lg h-64 w-full flex items-center justify-center text-gray-400">
          No image available
        </div>
      <% end %>
    </div>

    <section class="product-info space-y-4">
      <% cache [@product, @product.featured_image] do %>
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @product.name %></h1>
          <div class="text-gray-600 text-sm"><%= @product.description %></div>
        </div>
      <% end %>

      <p class="text-2xl font-semibold text-indigo-600">Price: $<%= @product.price %></p>

      <div>
        <%= render "inventory", product: @product %>
      </div>

      <% if authenticated? %>
        <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
          <%= link_to "Edit", edit_product_path(@product), class: "bg-gray-200 text-gray-800 px-4 py-2 rounded-lg font-medium hover:bg-gray-300 transition" %>
          <%= button_to "Delete", @product, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "bg-red-500 text-white px-4 py-2 rounded-lg font-medium hover:bg-red-600 transition cursor-pointer" %>
        </div>
      <% end %>
    </section>
  </div>
</div>